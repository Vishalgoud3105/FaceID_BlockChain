# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# --- Reverse image search -------------------------------------------------
# SerpApi Google Lens -- the reverse-image search engine.
# Free tier: 250 searches/month, no payment method required.
# Get one at https://serpapi.com  ->  https://serpapi.com/manage-api-key
# Needs a public image URL at run time (pass --image-url).
SERPAPI_KEY=

# --- Blockchain: Base Sepolia testnet -------------------------------------
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CHAIN_NAME=Base Sepolia
EXPLORER_TX_URL=https://sepolia.basescan.org/tx/

# Throwaway wallet ONLY. Fund from a Base Sepolia faucet:
#   https://www.alchemy.com/faucets/base-sepolia
# Never put a wallet holding real funds here.
WALLET_PRIVATE_KEY=0xyour_testnet_private_key

# Filled in by: python scripts/deploy_contract.py
CONTRACT_ADDRESS=

# --- Tuning ---------------------------------------------------------------
# Minimum InsightFace detection confidence to accept a face (0-1).
MIN_FACE_SCORE=0.5
